# 复制为项目根目录的 .env；不要把填好密钥的文件转发或提交到 Git。
NODE_ENV=production

# Docker 对外只绑定服务器本机。端口占用时改这里，并同步改反向代理端口。
HTTP_PORT=8787

# 直接运行 Node 时使用；Docker Compose 会单独设置容器内的监听地址。
HOST=127.0.0.1
PORT=8787

# 可不填，真人联机和本地机器人都能正常工作，不会调用付费 API。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=8000

ACTION_TIMEOUT_MS=60000
AUTO_START_SECONDS=6
BOT_THINK_MIN_MS=2500
BOT_THINK_MAX_MS=4000
