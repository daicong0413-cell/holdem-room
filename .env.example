# 复制成 .env 再填。服务端启动时会自动读取，真实的系统环境变量优先级更高。
# Copy to `.env` and fill in. The server reads it at startup; real environment
# variables always win over this file.

# ------------------------------------------------------------------ 大模型（可选）
# 不填就是「只用本地蒙特卡洛决策」，不消耗任何 token。
# Leave blank to run bots purely on local Monte Carlo — no tokens spent.

# 你的 API key。不要提交这个文件（.gitignore 已经排除 .env）。
DEEPSEEK_API_KEY=

# 兼容 OpenAI /chat/completions 的任意服务都行：
# any OpenAI-compatible /chat/completions endpoint works here:
#   DeepSeek   https://api.deepseek.com
#   OpenAI     https://api.openai.com/v1
#   月之暗面    https://api.moonshot.cn/v1
#   本地 Ollama http://127.0.0.1:11434/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名，留空则用内置默认值。
DEEPSEEK_MODEL=deepseek-chat

# 单次调用超时（毫秒），0 = 不超时。
DEEPSEEK_TIMEOUT_MS=8000

# ------------------------------------------------------------------ 服务端
# 公网部署必须设 NODE_ENV=production：关闭网页修改 API 配置和付费连接测试。
# 本机开发可不设置 NODE_ENV，直接访问 localhost 时仍可在网页管理配置。
# NODE_ENV=production

# 监听端口与地址。HOST=127.0.0.1 只允许本机访问。
PORT=8787
HOST=0.0.0.0

# 人类行动限时（毫秒），0 = 关闭。超时自动过牌，不能过牌则弃牌。
ACTION_TIMEOUT_MS=60000

# 一手结束后多少秒自动发下一手，0 = 手动。
AUTO_START_SECONDS=6

# 机器人思考时间。用 MIN/MAX 指定区间，或用 BOT_THINK_MS 指定对称区间
# （BOT_THINK_MS=0 让机器人立即行动，调试时很有用）。
BOT_THINK_MIN_MS=5000
BOT_THINK_MAX_MS=10000
